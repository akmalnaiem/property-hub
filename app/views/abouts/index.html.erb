<div class="about-page-wrapper">
  <!-- Hero Section -->
  <div class="about-hero">
    <div class="about-hero-overlay"></div>
    <div class="about-hero-content animate-fade-in">
      <h1 class="about-hero-title"><%= @about.hero_title %></h1>
      <p class="about-hero-subtitle">
        <%= @about.hero_subtitle%>
      </p>
    </div>
  </div>

    <!-- Edit/Delete Button -->
    <% if user_signed_in? && current_user.admin? %>
        <div class="admin-action-buttons">
            <%= button_to "Edit About Us",
              edit_about_path(@about),
              method: :get,
              class: "action-btn" %>
            <%#= button_to "Delete", about_path(@about),
                method: :delete,
                data: { confirm: "Are you sure?" },
                class: "action-btn" %>
        </div>
    <% end %>

  <!-- Stats Section -->
  <div class="about-stats-section">
    <div class="stats-container">
      <div class="stat-card animate-on-scroll">
        <div class="stat-icon">
          <i class="fas fa-building"></i>
        </div>
        <div class="stat-number" data-target="<%= @about.properties_listed %>">
            <%= @about.properties_listed %>        
        </div>
        <div class="stat-label">Properties Listed</div>
      </div>
      <div class="stat-card animate-on-scroll">
        <div class="stat-icon">
          <i class="fas fa-users"></i>
        </div>
        <div class="stat-number" data-target="<%= @about.happy_customers %>">
            <%= @about.happy_customers %>
        </div>
        <div class="stat-label">Happy Customers</div>
      </div>
      <div class="stat-card animate-on-scroll">
        <div class="stat-icon">
          <i class="fas fa-city"></i>
        </div>
        <div class="stat-number" data-target="<%= @about.cities_covered %>">
            <%= @about.cities_covered %>
        </div>
        <div class="stat-label">Cities Covered</div>
      </div>
      <div class="stat-card animate-on-scroll">
        <div class="stat-icon">
          <i class="fas fa-award"></i>
        </div>
        <div class="stat-number" data-target="<%= @about.years_experience %>">
            <%= @about.years_experience %>
        </div>
        <div class="stat-label">Years of Experience</div>
      </div>
    </div>
  </div>

  <!-- Our Mission Section -->
  <div class="about-section mission-section">
    <div class="about-content">
      <div class="about-text animate-on-scroll">
        <div class="section-badge">
          <i class="fas fa-bullseye"></i>
          <span>Our Mission</span>
        </div>
        <h2><%= @about.mission_title %></h2>
        <p>
          <%= simple_format(@about.mission_description) %>
        </p>
      </div>
      <div class="about-image animate-on-scroll">
        <div class="image-wrapper">
          <%= image_tag(@about.mission_image.attached? ? @about.mission_image : "aboutus/about2.jpg", alt: "Our Mission") %>
          <!-- <div class="image-overlay"></div> -->
        </div>
      </div>
    </div>
  </div>

  <!-- Our Vision Section -->
  <div class="about-section vision-section">
    <div class="about-content">
      <div class="about-image animate-on-scroll">
        <div class="image-wrapper">
          <%= image_tag(@about.vision_image.attached? ? @about.vision_image : "aboutus/about5.jpg", alt: "Our Vision") %>
          <div class="image-overlay"></div>
        </div>
      </div>
      <div class="about-text animate-on-scroll">
        <div class="section-badge">
          <i class="fas fa-eye"></i>
          <span>Our Vision</span>
        </div>
        <h2><%= @about.vision_title %></h2>
        <p>
          <%= simple_format(@about.vision_description) %>
        </p>
      </div>
    </div>
  </div>

  <!-- Our Values Section -->
  <div class="about-section values-section">
    <div class="values-container">
      <div class="section-header animate-fade-in">
        <div class="section-badge">
          <i class="fas fa-heart"></i>
          <span>Our Values</span>
        </div>
        <h2 class="values-heading">What Makes Us Different</h2>
        <p class="values-subtitle">We are committed to providing the best real estate experience</p>
      </div>
      <div class="values-grid">
        <!-- What We Offer Box -->
        <div class="value-box animate-on-scroll">
          <div class="value-box-image">
            <%= image_tag(@about.offer_image.attached? ? @about.offer_image : "aboutus/about3.png", alt: "What We Offer") %>
            <div class="value-box-overlay"></div>
          </div>
          <div class="value-box-content">
            <div class="value-icon">
              <i class="fas fa-gift"></i>
            </div>
            <h3>What We Offer</h3>
            <p><%= simple_format(@about.values_offer) %></p>
          </div>
        </div>

        <!-- Why Choose Us Box -->
        <div class="value-box animate-on-scroll">
          <div class="value-box-image">
            <%= image_tag(@about.why_choose_image.attached? ? @about.why_choose_image : "aboutus/about4.jpg", alt: "Why Choose Us") %>
            <div class="value-box-overlay"></div>
          </div>
          <div class="value-box-content">
            <div class="value-icon">
              <i class="fas fa-star"></i>
            </div>
            <h3>Why Choose Us</h3>
            <p><%= simple_format(@about.values_why) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Section -->
