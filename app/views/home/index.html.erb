<%= render "shared/search" %>

<!-- Enhanced Hero Section -->
<div class="hero-section">
  <div class="hero-overlay"></div>
  <div class="hero-image-container">
    <%= image_tag(@home.hero_image.attached? ? @home.hero_image : "home/real_state.jpg", alt: "Real Estate Properties", class: "hero-image") %>
    <div class="hero-content animate-fade-in">
      <div class="hero-badge">
        <i class="fas fa-shield-check"></i>
        <span><%= @home.hero_badge_text %></span>
      </div>
      <h1 class="hero-title"><%= @home.hero_title %></h1>
      <p class="hero-subtitle"><%= @home.hero_subtitle %></p>
      <div class="hero-stats">
        <div class="hero-stat-item">
          <div class="stat-number" data-target="<%= Property.count %>">1200</div>
          <div class="stat-label">Properties</div>
        </div>
        <div class="hero-stat-item">
          <div class="stat-number" data-target="50">48</div>
          <div class="stat-label">Locations</div>
        </div>
        <div class="hero-stat-item">
          <div class="stat-number" data-target="10000">5400</div>
          <div class="stat-label">Happy Clients</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit home page button -->
<% if user_signed_in? && current_user.admin? %>
  <div class="admin-edit-wrapper" >
    <%= button_to "Edit Home Page", edit_home_path(@home), method: :get, class: "admin-edit-btn" %>
  </div>
<% end %>

<!-- Features Section -->
<div class="features-section">
  <div class="features-container">
    <div class="feature-card animate-on-scroll">
      <div class="feature-icon">
        <i class="fas fa-shield-alt"></i>
      </div>
      <h3>RERA Verified</h3>
      <p>All properties are verified and compliant with RERA regulations</p>
    </div>
    <div class="feature-card animate-on-scroll">
      <div class="feature-icon">
        <i class="fas fa-search"></i>
      </div>
      <h3>Easy Search</h3>
      <p>Find your perfect property with advanced search and filter options</p>
    </div>
    <div class="feature-card animate-on-scroll">
      <div class="feature-icon">
        <i class="fas fa-handshake"></i>
      </div>
      <h3>Trusted Partners</h3>
      <p>Work with verified real estate professionals and developers</p>
    </div>
    <div class="feature-card animate-on-scroll">
      <div class="feature-icon">
        <i class="fas fa-mobile-alt"></i>
      </div>
      <h3>24/7 Support</h3>
      <p>Get assistance anytime with our dedicated support team</p>
    </div>
  </div>
</div>

<!-- Find Verified Properties Section -->
<div class="location-section">
