        <i class="fas fa-chevron-left"></i>
      </button>
      <div class="location-buttons-wrapper">
        <div class="location-buttons">
          <%= link_to root_path(city: "Katol Road"), class: "location-btn" do %>
            <i class="fas fa-map-marker-alt"></i>
            <span>Katol Road</span>
          <% end %>
          <%= link_to root_path(city: "Bhandara Road"), class: "location-btn" do %>
            <i class="fas fa-map-marker-alt"></i>
            <span>Bhandara Road</span>
          <% end %>
          <%= link_to root_path(city: "Amravati Road"), class: "location-btn" do %>
            <i class="fas fa-map-marker-alt"></i>
            <span>Amravati Road</span>
          <% end %>
          <%= link_to root_path(city: "Wardha Road"), class: "location-btn" do %>
            <i class="fas fa-map-marker-alt"></i>
            <span>Wardha Road</span>
          <% end %>
          <%= link_to root_path(city: "Koradi Road"), class: "location-btn" do %>
            <i class="fas fa-map-marker-alt"></i>
            <span>Koradi Road</span>
          <% end %>
          <%= link_to root_path(city: "Hingna Road"), class: "location-btn" do %>
            <i class="fas fa-map-marker-alt"></i>
            <span>Hingna Road</span>
          <% end %>
        </div>
      </div>
      <button class="location-scroll-btn location-scroll-right" aria-label="Scroll right">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
  </div>
</div>

<!-- Properties Section -->
<div class="home-container">
  <div class="home-header animate-fade-in">
    <div class="header-content">
      <h1>Premium Investments</h1>
      <p class="header-subtitle">Discover handpicked properties that match your requirements</p>
    </div>
    <div class="home-actions">
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to new_property_path, class: "add-property-btn" do %>
          <i class="fas fa-plus"></i>
          <span>Add Property</span>
        <% end %>
      <% end %>

      <%= link_to properties_path, class: "add-property-btn outline" do %>
        <span>Show all properties</span>
      <% end %>
    </div>
  </div>
</div>

  </div>

  <% if @properties.present? %>
    <div class="property-grid">
      <% @properties.each_with_index do |property, index| %>
      <div class="property-card animate-on-scroll" style="--card-index: <%= index %>;">

        <!-- Image -->
        <div class="property-image">
          <% if property.images.present? %>
            <%= image_tag property.images.first, class: "property-thumb", alt: property.title %>
          <% else %>
            <div class="image-placeholder">
              <i class="fas fa-image"></i>
            </div>
          <% end %>
          <!-- RERA Badge -->
          <div class="rera-badge">
            <i class="fas fa-check-circle"></i>
            <span>RERA Verified</span>
          </div>
          <!-- Category Badge -->
          <% if property.property_category.present? %>
            <div class="category-badge">
              <%= property.property_category.name %>
            </div>
          <% end %>
        </div>

        <div class="property-body">
          <h3 class="property-title"><%= property.title %></h3>

          <p class="property-location">
            <i class="fas fa-map-marker-alt"></i>
            <span><%= property.location %></span>
          </p>

          <!-- Property Details -->
          <div class="property-details">
            <% if property.bedrooms.present? %>
              <div class="detail-item">
                <i class="fas fa-bed"></i>
                <span><%= property.bedrooms %> BHK</span>
              </div>
            <% end %>
            <% if property.bathrooms.present? %>
              <div class="detail-item">
                <i class="fas fa-bath"></i>
                <span><%= property.bathrooms %> Bath</span>
              </div>
            <% end %>
            <% if property.area_sqft.present? %>
              <div class="detail-item">
                <i class="fas fa-ruler-combined"></i>
                <span><%= property.area_sqft %> sqft</span>
              </div>
            <% end %>
          </div>

          <p class="property-description">
            <%= truncate(property.description, length: 80) %>
          </p>

          <div class="property-footer">
            <div class="price-section">
              <span class="property-price">₹ <%= number_with_delimiter(property.price) %></span>
              <% if property.area_sqft.present? && property.area_sqft > 0 %>
                <span class="price-per-sqft">₹ <%= number_with_delimiter((property.price.to_f / property.area_sqft).round) %>/sqft</span>
              <% end %>
            </div>

            <div class="property-actions">
              <!-- Share icon button -->
              <%= link_to "https://wa.me/?text=#{CGI.escape(property_url(property))}",
              target: "_blank", class: "share-btn", title: "Share on WhatsApp" do %>
                <i class="fab fa-whatsapp"></i>
              <% end %>

              <!-- View button -->
              <%= link_to property_path(property), class: "view-btn" do %>
                <span>View Details</span>
                <i class="fas fa-arrow-right"></i>
              <% end %>
            </div>
          </div>

        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state animate-fade-in">
    <div class="empty-icon">
      <i class="fas fa-home"></i>
    </div>
    <h2>No Properties Available</h2>
    <p>Check back soon for new property listings!</p>
    <% if user_signed_in? && current_user.admin? %>
      <%= link_to new_property_path, class: "add-property-btn empty-btn" do %>
        <i class="fas fa-plus"></i>
        <span>Add Your First Property</span>
      <% end %>
    <% end %>
  </div>
<% end %>
</div>

