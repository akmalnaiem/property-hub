<!-- Contact Hero Section -->
<div class="contact-hero">
  <div class="contact-hero-container">
    <h1 class="contact-hero-title">Get In Touch</h1>
    <p class="contact-hero-subtitle">We're here to help you find your dream property</p>
  </div>
</div>

<!-- Contact Main Section -->
<div class="contact-main-section">
  <div class="contact-container">
    
    <!-- Contact Form Section -->
    <div class="contact-form-section">
      <div class="contact-form-card">
        <div class="form-header">
          <h2>Send us a Message</h2>
          <p>Fill out the form below and we'll get back to you as soon as possible</p>
        </div>

        <%= form_with url: contact_path, method: :post, local: true, class: "contact-form" do |f| %>
          <div class="form-group">
            <%= f.label :name, "Full Name" do %>
              <i class="fas fa-user"></i>
              <span>Full Name</span>
            <% end %>
            <%= f.text_field :name, placeholder: "Enter your full name", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :email, "Email Address" do %>
              <i class="fas fa-envelope"></i>
              <span>Email Address</span>
            <% end %>
            <%= f.email_field :email, placeholder: "Enter your email address", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :phone, "Phone Number" do %>
              <i class="fas fa-phone"></i>
              <span>Phone Number</span>
            <% end %>
            <%= f.telephone_field :phone, placeholder: "Enter your phone number" %>
          </div>

          <div class="form-group">
            <%= f.label :subject, "Subject" do %>
              <i class="fas fa-tag"></i>
              <span>Subject</span>
            <% end %>
            <%= f.text_field :subject, placeholder: "What is this regarding?" %>
          </div>

          <div class="form-group">
            <%= f.label :message, "Message" do %>
              <i class="fas fa-comment"></i>
              <span>Your Message</span>
            <% end %>
            <%= f.text_area :message, rows: 5, placeholder: "Write your message here...", required: true %>
          </div>

          <%= f.submit "Send Message", class: "contact-submit-btn" %>
        <% end %>
      </div>
    </div>

    <!-- Contact Info Section -->
    <div class="contact-info-section">
      <div class="contact-info-card">
        <h2>Contact Information</h2>
        <p class="info-description">Reach out to us through any of these channels</p>

        <div class="contact-info-items">
          <!-- Address Card -->
          <div class="info-item" style="--item-index: 0;">
            <div class="info-icon">
              <i class="fas fa-map-marker-alt"></i>
            </div>
            <div class="info-content">
              <h3>Office Address</h3>
              <p>123 Property Street<br>Nagpur, Maharashtra 440001<br>India</p>
            </div>
          </div>

          <!-- Phone Card -->
          <div class="info-item" style="--item-index: 1;">
            <div class="info-icon">
              <i class="fas fa-phone-alt"></i>
            </div>
            <div class="info-content">
              <h3>Phone Number</h3>
              <p>
                <a href="tel:+919876543210">+91 98765 43210</a><br>
                <a href="tel:+919876543211">+91 98765 43211</a>
              </p>
            </div>
          </div>

          <!-- Email Card -->
          <div class="info-item" style="--item-index: 2;">
            <div class="info-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="info-content">
              <h3>Email Address</h3>
              <p>
                <a href="mailto:info@shadboxProperty.com">info@shadboxProperty.com</a><br>
                <a href="mailto:support@shadboxProperty.com">support@shadboxProperty.com</a>
              </p>
            </div>
          </div>

          <!-- Business Hours Card -->
          <div class="info-item" style="--item-index: 3;">
            <div class="info-icon">
              <i class="fas fa-clock"></i>
            </div>
            <div class="info-content">
              <h3>Business Hours</h3>
              <p>
                Monday - Friday: 9:00 AM - 7:00 PM<br>
                Saturday: 10:00 AM - 5:00 PM<br>
                Sunday: Closed
              </p>
            </div>
          </div>
        </div>

        <!-- Social Media Links -->
        <div class="social-links">
          <h3>Follow Us</h3>
          <div class="social-icons">
            <a href="#" class="social-icon" aria-label="Facebook">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="#" class="social-icon" aria-label="Twitter">
              <i class="fab fa-twitter"></i>
            </a>
            <a href="#" class="social-icon" aria-label="Instagram">
              <i class="fab fa-instagram"></i>
            </a>
            <a href="#" class="social-icon" aria-label="LinkedIn">
              <i class="fab fa-linkedin-in"></i>
            </a>
            <a href="#" class="social-icon" aria-label="WhatsApp">
              <i class="fab fa-whatsapp"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Map Section (Optional) -->
<div class="contact-map-section">
  <div class="map-container">
    <div class="map-placeholder">
      <i class="fas fa-map-marked-alt"></i>
      <p>Map Location</p>
      <span>Interactive map would be embedded here</span>
    </div>
  </div>
</div>
