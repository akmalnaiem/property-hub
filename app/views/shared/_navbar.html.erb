<!-- Top Header Bar (Dark Purple) -->
<div class="rera-top-header">
  <div class="rera-top-header-container">
    <!-- Logo and Brand -->
    <div class="rera-brand-section">
      <%= link_to root_path, class: "rera-brand-link" do %>
        <span class="rera-logo-text">R</span>
        <span class="rera-brand-name">ShadboxProperty.Com</span>
      <% end %>
      
      <!-- City Selector -->
      <button class="rera-city-btn">
        <span>Nagpur</span>
        <i class="fas fa-chevron-down"></i>
      </button>
    </div>

    <!-- Top Navigation -->
    <div class="rera-top-nav">
      <!-- SP Prime Dropdown -->
      <div class="rera-nav-dropdown">
        <%= link_to "#", class: "rera-top-nav-link" do %>
          <span>SP Prime</span>
          <i class="fas fa-chevron-down"></i>
        <% end %>
        <div class="rera-dropdown-menu">
          <div class="rera-dropdown-item">
            <p>Refer to 5 friends and be a Prime Member for Free. <a href="#">Learn More...</a></p>
          </div>
        </div>
      </div>

      <!-- Login/Register -->
      <% if user_signed_in? %>
        <div class="rera-nav-dropdown">
          <%= link_to "#", class: "rera-top-nav-link" do %>
            <span><%= current_user.name %></span>
            <i class="fas fa-chevron-down"></i>
          <% end %>
          <div class="rera-dropdown-menu">
            <%= link_to "Profile", edit_user_registration_path, class: "rera-dropdown-item" %>
            <%= link_to "All Posts", blogs_path, class: "rera-dropdown-item" %>
            <% if current_user.admin? %>
              <%= link_to "Create Blog", new_blog_path, class: "rera-dropdown-item" %>
            <% end %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "rera-dropdown-item rera-dropdown-button" %>
          </div>
        </div>
      <% else %>
        <%= link_to new_user_session_path, class: "rera-top-nav-link" do %>
          <span>Login/Register</span>
        <% end %>
      <% end %>

      <!-- Post Property Button -->
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to new_property_path, class: "rera-post-property-btn" do %>
          <span>Post Property</span>
        <% end %>
      <% end %>

      <!-- Download App Button -->
      <button class="rera-download-app-btn">
        <i class="fab fa-android"></i>
        <span>Download App</span>
      </button>
    </div>
  </div>
</div>

<!-- Secondary Navigation Bar -->
<div class="rera-secondary-nav">
  <div class="rera-secondary-nav-container">
    <%= link_to root_path, class: "rera-secondary-nav-link" do %>
      <span>Home</span>
    <% end %>

    <!-- Home Loans Button  -->
    <div class="rera-nav-dropdown">
      <%= link_to "#", class: "rera-secondary-nav-link has-dropdown" do %>
        <span>Home Loans</span>
        <!-- <i class="fas fa-chevron-down"></i> -->
      <% end %>
      <!-- <div class="rera-dropdown-menu">
        <a href="#" class="rera-dropdown-item">Home Loan Options</a>
        <a href="#" class="rera-dropdown-item">Calculate EMI</a>
      </div> -->
    </div>

    <!-- About Us Button -->
    <div class="rera-nav-dropdown">
      <%= link_to abouts_path, class: "rera-secondary-nav-link has-dropdown" do %>
        <span>About Us</span>
      <% end %>
    </div>


    <!-- Blog Button -->
    <%= link_to blogs_path, class: "rera-secondary-nav-link" do %>
      <span>Blogs</span>
    <% end %>

    <!-- Properties Button -->
    <div class="rera-nav-dropdown">
      <%= link_to properties_path, class: "rera-secondary-nav-link" do %>
        <span>Properties</span>
      <% end %>
    </div>


    <!-- Contact Us Button -->
    <div class="rera-nav-dropdown">
      <%= link_to contact_path, class: "rera-secondary-nav-link has-dropdown" do %>
        <span>Contact Us</span>
        <!-- <i class="fas fa-chevron-down"></i> -->
      <% end %>
      <!-- <div class="rera-dropdown-menu">
        <a href="#" class="rera-dropdown-item">FAQ</a>
        <a href="#" class="rera-dropdown-item">Contact Support</a>
      </div> -->
    </div>
  </div>
</div>